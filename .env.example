# --- Server ---
PORT=3000
DATA_DIR=data
BASE_URL=https://lemango.org
# Comma-separated list of allowed frontend origins for CORS (split hosting).
# Example: https://lemango.org,https://www.lemango.org
ALLOWED_ORIGINS=
# Secret used to sign session cookies. Change this to a long random string in production.
SESSION_SECRET=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email delivery (SMTP) ---
# If these are left blank, emails are NOT sent. Instead each composed message
# is written as a .eml draft into data/outbox/ so nothing is lost.
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
#                SMTP_USER=lemangonewsletter@gmail.com  SMTP_PASS=<app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Lemango <no-reply@lemango.org>

# Where new-subscriber notifications are sent.
NEWSLETTER_INBOX=lemangonewsletter@gmail.com

# --- AI providers (optional) ---
# Lemango AI works out of the box using a free keyless provider. Adding any of
# the keys below unlocks faster / stronger providers and automatic failover.
# Every response is branded "Lemango AI"; the provider is never disclosed.
POLLINATIONS_MODEL=openai
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Space Bunny Alpha (free 1M-context model via OpenRouter). Uses OPENROUTER_API_KEY if unset.
SPACEBUNNY_API_KEY=
SPACEBUNNY_MODEL=stealth/space-bunny-alpha
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Override the Lemango AI persona/system prompt (optional).
AI_SYSTEM_PROMPT=
# Set to 1 to force preview mode (no outbound AI calls).
AI_DISABLE_LIVE=
# Per-request provider timeout in milliseconds.
AI_TIMEOUT_MS=45000

# --- Ads ---
# Google AdSense publisher ID, e.g. ca-pub-1234567890123456
ADSENSE_CLIENT=
